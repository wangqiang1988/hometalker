# ============================================
#  FooTalker 家庭版 配置
#  复制本文件为 .env 后按需修改：cp .env.example .env
# ============================================

# 内网服务器地址。会被写进 TLS 证书的 SAN，手机必须能访问到这个地址。
# 建议：给服务器配静态 IP，或在路由器上做 DHCP 地址保留（地址变了证书要重签）。
# 也可以填内网域名，如 talk.home（需在路由器或 AdGuard/Pi-hole 上做静态解析）。
SITE_ADDR=192.168.1.50

# 家庭口令。必填！留空时 server 会拒绝启动，防止忘记设口令裸奔。
FAMILY_CODE=change-me

# 房间显示名
ROOM_NAME=home

# server 内部监听端口（对外由 Caddy 的 443 反代）
PORT=8443

# 对外暴露的 HTTPS 端口。
# 路由器管理界面占用 443 时改成 8443，手机访问 https://192.168.1.50:8443
# （端口号不参与证书校验，不影响 HTTPS）
HTTPS_PORT=443

# 单个房间人数上限
MAX_MEMBERS=12

# 单次发言最长时长（毫秒）。到时服务端自动放麦，防止有人霸占。
MAX_SPEAK_MS=60000

# 抢麦模式
#   preempt  = 新说话的人直接接管麦（家庭场景更友好，默认）
#   exclusive = 拒绝并提示"麦已被占"，需等对方松手
SPEAK_MODE=preempt

# 日志级别：debug | info | warn | error
LOG_LEVEL=info
